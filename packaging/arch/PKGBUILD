# Maintainer: @MAINTAINER@
#
# Masurium Launcher for Arch Linux and its family (CachyOS, EndeavourOS,
# Manjaro...): the program, the Masurium jars of its release, a `masurium`
# command and an entry in the applications menu. The window runs on the
# system's Qt for Python (pyside6), and the bots on Java 21, which may live
# beside a newer default Java: the launcher finds it in /usr/lib/jvm.
#
# tools/release.sh writes this into dist/ with the release's version and
# checksum. Next to the release's tarball, makepkg uses that one instead of
# downloading it:
#
#   makepkg -si
pkgname=masurium-launcher
pkgver=@VERSION@
pkgrel=1
pkgdesc="Launcher for Masurium's AI-driven Minecraft bots"
arch=('any')
url="https://github.com/CharquiPayload/masurium"
license=('MIT')
depends=('python' 'pyside6' 'jre21-openjdk-headless')
optdepends=('claude-code: the bots'"'"' brain, if not installed with its own installer into ~/.local/bin')
source=("https://github.com/CharquiPayload/masurium/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('@SHA256@')

package() {
    cd "$pkgname-$pkgver"
    local app="$pkgdir/usr/share/$pkgname"

    install -d "$app"
    cp -R --no-preserve=ownership launcher mcp docs jars README.md LICENSE CHANGELOG.md "$app/"
    find "$app" -name __pycache__ -type d -prune -exec rm -rf {} +
    find "$app" -type d -exec chmod 755 {} +
    find "$app" -type f -exec chmod 644 {} +
    chmod 755 "$app/launcher/masurium.py"
    python -m compileall -q -s "$pkgdir" -p / "$app/launcher" "$app/mcp"

    install -Dm755 packaging/arch/masurium "$pkgdir/usr/bin/masurium"
    install -Dm644 packaging/$pkgname.desktop "$pkgdir/usr/share/applications/$pkgname.desktop"
    local s
    for s in 32 48 64 128 256 512; do
        install -Dm644 "launcher/gui/appicon/$pkgname-$s.png" \
            "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/$pkgname.png"
    done
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
