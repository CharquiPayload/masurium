#!/bin/sh
# The window's Python environment, made here from the wheels the package
# brought (no internet needed), with the system's Python: a venv cannot be
# built beforehand, it belongs to the Python it was made with.
set -e
OPT=/opt/masurium-launcher
if [ "$1" = configure ]; then
    rm -rf "$OPT/venv"
    python3 -m venv "$OPT/venv"
    "$OPT/venv/bin/python" -m pip install --quiet --disable-pip-version-check --no-index \
        --find-links "$OPT/wheels" PySide6-Essentials
    "$OPT/venv/bin/python" -m compileall -q "$OPT/app" >/dev/null 2>&1 || true
fi
exit 0
