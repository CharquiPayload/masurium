#!/bin/sh
# What postinst made goes with the package (or is made again by the next one).
set -e
OPT=/opt/masurium-launcher
case "$1" in
    remove|upgrade|deconfigure)
        rm -rf "$OPT/venv"
        find "$OPT/app" -name __pycache__ -type d -prune -exec rm -rf {} + 2>/dev/null || true
        ;;
esac
exit 0
